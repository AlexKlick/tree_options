[Unit]
Description=trex discovery runner (scan-on-demand + daily auto scan)
Documentation=file:///home/alexk/documents/tree_options/docs/trex-discovery-runbook.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/alexk/documents/tree_options
# Import the main checkout's code whatever the shared .venv's editable pointer
# says (on 2026-09-23 an unknown writer repointed it to a worktree).
Environment=PYTHONPATH=/home/alexk/documents/tree_options/src
ExecStart=/home/alexk/.local/bin/uv run --group trex python -m tree_options.trex.discovery --serve
Restart=on-failure
RestartSec=30
# Hosted LLM fallback keys for watchlist proposals: the same file the
# claude-zai / claude-minimax2 launchers source (one copy, rotation-safe).
# Optional: without it the chain degrades to the local lane.
EnvironmentFile=-%h/.claude/.env
# Broker-side lane (owns gateway clientId 74; never places orders). NOT
# sandboxed: uv must write .venv/cache on group switches and the runner
# writes scans/account under %h/.local/state/trex-discovery.
# Config: %h/.config/trex/discovery.toml (default ships in deploy/trex/)

[Install]
WantedBy=default.target
