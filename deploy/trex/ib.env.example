# IB Gateway paper-account credentials. Copy to ~/.config/trex/ib.env, chmod 600.
# Paper logins usually need no 2FA; if the gateway session drops and noVNC
# shows a 2FA prompt, complete it at http://127.0.0.1:6080.
TWS_USERNAME=your-paper-username
TWS_PASSWORD=your-paper-password
TRADING_MODE=paper
