# IB Gateway paper-account credentials. Copy to ~/.config/trex/ib.env, chmod 600.
#
# The gnzsnz/ib-gateway image renders IBC's IbLoginId from TWS_USERID. An
# env file that sets only TWS_USERNAME (as this example once did) gives IBC
# a blank username: every automated login stalls on the open dialog and
# only a manual noVNC login works (2026-09-18..23; see
# docs/trex-gateway-runbook.md). tests/unit/test_trex_gateway_watch.py pins
# these names against the image.
TWS_USERID=your-paper-username
TWS_PASSWORD=your-paper-password
TRADING_MODE=paper
# x11vnc only starts when this is set; the novnc sidecar bridges it to
# https://<host>:6080/vnc.html?path=vnc (easy-novnc serves its socket at
# /vnc, not noVNC's default /websockify).
VNC_SERVER_PASSWORD=choose-an-8-char-password
