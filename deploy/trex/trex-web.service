[Unit]
Description=trex read-only HTTP status panel (loopback :8090)
Documentation=file:///home/alexk/documents/tree_options/src/tree_options/trex_web/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/alexk/documents/tree_options
# Import the main checkout's code whatever the shared .venv's editable pointer
# says (on 2026-09-23 an unknown writer repointed it to a worktree).
Environment=PYTHONPATH=/home/alexk/documents/tree_options/src
Environment=UV_NO_SYNC=1
ExecStart=/home/alexk/.local/bin/uv run --group trex-web python -m tree_options.trex_web --host 127.0.0.1 --port 8090
Restart=on-failure
RestartSec=5
# Read-only operator tool: only the trex state dirs under %h/.local/state
# are read, plus two writable directories — the discovery spool (scan
# requests from the site) and the research lane's own workspace
# (runstate store for /api/research/*; RL-1). Both must EXIST before the
# unit starts (ReadWritePaths on a missing path fails the unit):
#   mkdir -p ~/.local/state/trex-discovery/spool
#   mkdir -p ~/.local/state/trex-research/run-anon
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/alexk/.cache/uv /home/alexk/.local/share/uv /home/alexk/.local/state/trex-discovery/spool /home/alexk/.local/state/trex-research
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=default.target