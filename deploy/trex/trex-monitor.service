[Unit]
Description=trex exit machine (touch/time-stop supervisor for the options book)
Documentation=file:///home/alexk/documents/tree_options/src/tree_options/trex/README.md
# The gateway is a container; after boot it needs ~60s to log in.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/alexk/documents/tree_options
# Import the main checkout's code whatever the shared .venv's editable pointer
# says (on 2026-09-23 an unknown writer repointed it to a worktree).
Environment=PYTHONPATH=/home/alexk/documents/tree_options/src
# Start the moment the gateway API answers (real IB handshake, polled every
# 5s) instead of crash-looping against a logged-out gateway (1,276 restarts
# on 2026-09-23). While it stays down, one attempt per ~5 min.
ExecStartPre=/home/alexk/.local/bin/uv run --group trex --no-sync python -m tree_options.trex.gateway_watch --wait-api 300
TimeoutStartSec=360
ExecStart=/home/alexk/.local/bin/uv run --group trex python -m tree_options.trex.monitor --plan plans/2026-09-22.toml
Restart=on-failure
RestartSec=15
# The monitor is the trade: if it stays down, the book has no exit machine.
# systemd restarts it; the entry runner independently refuses to arm while
# its heartbeat/flock are dead.

[Install]
WantedBy=default.target
