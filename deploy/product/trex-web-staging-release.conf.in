[Service]
# Drop-in for trex-web-staging.service (loopback :8091). Code only: the base
# unit's staging state roots (desk state, paper workspace, research, discovery)
# and its single staging ReadWritePaths stay in force (a recovery release resets
# them below). Never point staging at the release's production state; this file
# sets no state variable.
WorkingDirectory=@SOURCE@
Environment=PYTHONPATH=@SOURCE@/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TREX_RELEASE_DIR=@RELEASE_DIR@
Environment=TREX_RECOVERY_READ_ONLY=@RECOVERY_READ_ONLY@
ExecStartPre=
ExecStartPre=@SOURCE@/.venv/bin/python -m tree_options.trex.premarket --check
ExecStart=
ExecStart=@SOURCE@/.venv/bin/python -m tree_options.trex_web --host 127.0.0.1 --port 8091 @RECOVERY_FLAG@
ExecStartPost=
# A recovery release is read-only for every web process, staging included.
@WEB_WRITE_ACCESS@
