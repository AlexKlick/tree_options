[Unit]
Description=TREX paper acceptance recorder and publication (no broker effects)
[Service]
Type=oneshot
WorkingDirectory=@SOURCE@
Environment=PYTHONPATH=@SOURCE@/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TREX_RELEASE_DIR=@RELEASE_DIR@
Environment=TREX_PREMARKET_RUNS=@PREMARKET_RUNS@
Environment=TREX_ACCEPTANCE_DIR=@DESK_STATE@/acceptance
# TREX_OWNER_EMAILS (comma-separated owner emails) lives in this private
# file. Without it the job still samples but publishes no document (exit 3).
EnvironmentFile=-%h/.config/trex/acceptance.env
# The document is computed by release code, so the release identity check
# gates the start. Its failure report is best effort under this sandbox.
ExecStartPre=@SOURCE@/.venv/bin/python -m tree_options.trex.premarket --check
# Direct interpreter, not host-work: under ProtectHome= the wrapper cannot write
# its /run/user payload, and its transient unit would drop this sandbox. Memory
# is capped here instead (the publisher caps; unmeasured for this job).
# Reads the desk run dir, the supervised dir and gateway.json; writes only
# its acceptance directory (create it once: install -d -m 0700).
ExecStart=@SOURCE@/.venv/bin/python -m tree_options.trex.acceptance publish
# Exit 3 means a valid degraded run (problems listed, or no owner configured).
SuccessExitStatus=3
Slice=host-work.slice
MemoryHigh=384M
MemoryMax=512M
Nice=10
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@DESK_STATE@/acceptance
