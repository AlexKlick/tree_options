[Unit]
Description=TREX experiment inventory publication (no study or broker effects)
[Service]
Type=oneshot
WorkingDirectory=@SOURCE@
Environment=PYTHONPATH=@SOURCE@/src
Environment=PYTHONDONTWRITEBYTECODE=1
# Direct interpreter, not host-work: under ProtectHome= the wrapper cannot write
# its /run/user payload, and its transient unit would drop this sandbox. Memory
# is capped here instead (unmeasured; confirm on the first supervised run).
ExecStart=@SOURCE@/.venv/bin/python -m tree_options.research.experiments --config @EXPERIMENT_SOURCES@ --out @EXPERIMENT_SNAPSHOT@ --source-release @RELEASE_HEAD@
# Exit 3 means a valid degraded publication with unavailable sources.
SuccessExitStatus=3
Slice=host-work.slice
MemoryHigh=384M
MemoryMax=512M
Nice=10
TimeoutStartSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@DESK_STATE@
