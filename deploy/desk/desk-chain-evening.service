[Unit]
Description=Options desk: record the evening observation tier of the CBOE chains (post-close, the persistent late cohort)
Documentation=file:///home/alexk/documents/tree_options/docs/desk/EVENING-TIER.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Slice=host-work.slice
Nice=10
Environment=HOME=/home/alexk
WorkingDirectory=/home/alexk/documents/tree_options
# Import the main checkout's code whatever the shared .venv's editable pointer
# says (on 2026-09-23 an unknown writer repointed it to a worktree).
Environment=PYTHONPATH=/home/alexk/documents/tree_options/src
# SHIPS UNINSTALLED: nothing here is installed into ~/.config/systemd or any
# other unit path; the operator installs it (or not) by hand.
# One post-close observation per name per session into the evening tier's
# own namespace (chains/clock=evening/<D>/ + manifest/clock=evening/<D>.json):
# fresh means the payload's own source_as_of is at or after the session
# close (16:00 ET). This is NOT a clock backfill and NOT decision-time data
# (docs/desk/EVENING-TIER.md); the day-1 clock evidence (2026-10-01) showed
# a persistent late cohort (CRM/DIS/LLY/PEP/PG/V/XLE/XLV) whose CBOE
# delayed publications never roll inside any 10-minute clock window but
# have fully rolled by evening. Single pass by design: no SPY probe, no
# stale-retry passes (those are clock-tiers-only); a later-evening fire
# (Persistent catch-up) still passes the at-or-after-close freshness rule
# and stays an honest observation of the same session.
ExecStart=/home/alexk/documents/tree_options/.venv/bin/python -m tree_options.desk record-chains --clock evening
# exit 3 = a name's publication never rolled past the close (frozen feed):
# benign, the overnight eod recorder is the safety net. 1 = < 90% recorded.
SuccessExitStatus=3
# the paced universe sweep only (no probe, no retry passes): 37 names at
# 1 request/s, up to 30 s each on a slow CDN
TimeoutStartSec=1800
