[Unit]
Description=Options desk: nightly challenge-digest watch (post-game checks, journal only)
Documentation=file:///home/alexk/documents/tree_options/docs/desk/DESK-LAB.md

[Service]
Type=oneshot
Slice=host-work.slice
Nice=10
Environment=HOME=/home/alexk
# never re-sync the shared .venv, never write .pyc into the checkout
Environment=UV_NO_SYNC=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Import the main checkout's code whatever the shared .venv's editable pointer
# says (on 2026-09-23 an unknown writer repointed it to a worktree).
Environment=PYTHONPATH=/home/alexk/documents/tree_options/src
Environment=DESK_STORE=/home/alexk/documents/tree_options/artifacts/desk-store
WorkingDirectory=/home/alexk/documents/tree_options
# The shared .venv's editable install is the main checkout (never re-synced here).
# Read-only checks on the store the 19:00 desk-challenge.game just wrote:
# (1) a digest stamped at/after 19:00 America/Denver today exists under
# evaluations/challenge/, (2) its digest.json status is ok, (3) standings.json
# is NEWER than the digest (the challenge service's ExecStartPost ran), and
# (4) model_failures across the digest is zero (warned, never failed).
# No notifications, no network, no writes: journald is the whole surface —
# the ops loop reads `journalctl --user -u desk-digest-watch.service`.
# exit 0 = every check passed (warnings allowed); exit 1 = a check failed
# and every failure already has its own journal line.
ExecStart=/home/alexk/documents/tree_options/.venv/bin/python scripts/desk_digest_watch.py
TimeoutStartSec=120
MemoryHigh=128M
MemoryMax=192M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
