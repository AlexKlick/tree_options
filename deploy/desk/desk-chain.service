[Unit]
Description=Options desk: record the CBOE delayed option chains for the latest closed session
Documentation=file:///home/alexk/documents/tree_options/docs/desk-runbook.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Slice=host-work.slice
Nice=10
Environment=HOME=/home/alexk
WorkingDirectory=/home/alexk/documents/tree_options
# The shared .venv's editable install is the main checkout (never re-synced here).
ExecStart=/home/alexk/documents/tree_options/.venv/bin/python -m tree_options.desk record-chains
# exit 3 = the overnight snapshot is not published yet (or still describes
# the prior session): benign, the next timer slot retries. 1 = < 90% recorded.
SuccessExitStatus=3
# 35 symbols at 1 request/s, up to 30 s each on a slow CDN
TimeoutStartSec=1800
# No pushes from this job, so no notify.env. Store: artifacts/desk-store/
# (DESK_STORE overrides); manifest/<D>.json and gaps.jsonl report coverage.
