[Unit]
Description=Options desk: refresh the forward minute-bar contract selection
Documentation=file:///home/alexk/documents/tree_options/docs/desk-runbook.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Slice=host-work.slice
Nice=10
Environment=HOME=/home/alexk
WorkingDirectory=/home/alexk/documents/tree_options
# Import the main checkout's code whatever the shared .venv's editable pointer
# says (on 2026-09-23 an unknown writer repointed it to a worktree).
Environment=PYTHONPATH=/home/alexk/documents/tree_options/src
ExecStart=/home/alexk/documents/tree_options/.venv/bin/python -m tree_options.desk forward-select
# Reads the recorded chains only (NO wire requests; the selection is free).
# exit 1 = no chain session at or before today records IWM/QQQ/SPY -- check
# desk-chain's manifest first. Write-once per date: re-runs are no-ops.
TimeoutStartSec=300
