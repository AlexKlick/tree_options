# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.hypothesis/

# Runtime outputs (trial DBs, stamped artifacts)
artifacts/
# Vendor response cache (M4-A WS-D1). Redundant under artifacts/ above, but
# stated explicitly: these bodies are fetched with a paid-quota API key and
# must never be committed, even if artifacts/ is ever narrowed.
artifacts/massive-cache/
*.db

# Editors
.idea/
.vscode/
*.swp

# Web (trex cockpit SPA): deps and the Vite build output. The build is a
# deploy-time step (cd web && npm ci && npm run build), never committed.
web/node_modules/
src/tree_options/trex_web/static/
